---
import { Image } from 'astro:assets';
import monogram from '../assets/brand/monogram.png';

interface Props {
  size?: 'header' | 'footer';
}

const { size = 'header' } = Astro.props;
const px = size === 'footer' ? 88 : 40;
---

<span class:list={['wordmark', `wordmark--${size}`]}>
  <Image src={monogram} alt="" width={px} height={px} densities={[1, 2]} class="wordmark__mark" loading="eager" />
  <span class="wordmark__text">
    <span class="wordmark__name">Atlantic &amp; Co.</span>
    <span class="wordmark__sub">Media</span>
  </span>
</span>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--ink);
  }

  .wordmark__mark {
    flex: none;
    width: 2.5rem;
    height: 2.5rem;
  }

  .wordmark--footer .wordmark__mark {
    width: 5.5rem;
    height: 5.5rem;
  }

  .wordmark__text {
    display: grid;
    justify-items: center;
    line-height: 1;
  }

  .wordmark__name {
    font-family: var(--font-display);
    font-size: 1.125rem;
    letter-spacing: -0.005em;
    white-space: nowrap;
  }

  /* "MEDIA" is part of the logo lockup, so it keeps the logo's spaced capitals */
  .wordmark__sub {
    margin-top: 0.25rem;
    margin-right: -0.42em;
    font-family: var(--font-text);
    font-size: 0.5625rem;
    font-weight: 500;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    color: var(--gold);
  }

  .wordmark--footer .wordmark__name {
    font-size: 1.75rem;
  }

  .wordmark--footer .wordmark__sub {
    font-size: 0.75rem;
  }

  @media (max-width: 23.4375em) {
    .wordmark--header .wordmark__text {
      display: none;
    }
  }
</style>
